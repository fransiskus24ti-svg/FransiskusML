<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">


    <!-- Ganti @drawable/mobile jika sudah diganti nama -->


    <ImageView
        android:id="@+id/imgMobile"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginBottom="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/redbull" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:fontFamily="@font/archivoblack_regular"
        android:text="@string/verif"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold" />


    <EditText
        android:id="@+id/inputNoTujuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/archivoblack_regular"
        android:hint="Masukkan No Tujuan"
        android:inputType="phone"
        android:textColor="#000000"
        android:textColorHint="#666666"
        android:textSize="16sp" />


    <Button
        android:id="@+id/btnKirim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:backgroundTint="@color/abugelap"
        app:backgroundTint="@color/abugelap"
        android:fontFamily="@font/archivoblack_regular"
        android:text="Kirim"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>